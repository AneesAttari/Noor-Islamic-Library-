rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Books collection security rules
    match /books/{bookId} {
      // Public visitors can ONLY read published book records
      allow get, list: if resource.data.published == true;
      
      // Only authenticated users with admin claims can read drafts or create/edit/delete books
      allow read, write: if request.auth != null && 
        (request.auth.token.admin == true || request.auth.token.role in ['super_admin', 'librarian']);
    }
    
    // Deny all other collections by default to prevent unintended public access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
